{
  "permissions": {
    "deny": [
      "Edit(~/.claude/plugins/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "PowerShell"
    ],
    "allow": [
      "Edit(/**)",
      "Read(~/.claude/plugins/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "federicode": {
      "source": {
        "source": "github",
        "repo": "Federicogimenez/claude"
      }
    }
  },
  "enabledPlugins": {
    "harness@federicode": true
  }
}
