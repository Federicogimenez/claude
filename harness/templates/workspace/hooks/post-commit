#!/bin/sh
# Wrapper monorepo de graphify — harness federicode.
# Un workspace = un repo git con N solutions, cada una con su grafo (graphify-out/).
# El hook nativo (`graphify hook install`) asume un repo por proyecto: instala un solo
# hook en la raíz que mantiene un solo grafo. Este wrapper lo reemplaza: reconstruye el
# grafo de cada solution tocada por el commit.
# Lo instala /harness:adopt copiándolo a .git/hooks/post-commit. La fuente vive en el
# harness (templates/workspace/hooks/post-commit) — mejoras allá, no acá.

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

# No corras durante rebase/merge/cherry-pick
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

# uv tool instala el launcher en ~/.local/bin; los GUI clients suelen no traerlo en PATH
PATH="$PATH:$HOME/.local/bin"
command -v graphify >/dev/null 2>&1 || {
    echo "[graphify] launcher no encontrado en PATH — grafos sin refrescar (corré 'graphify update .' en cada solution tocada)"
    exit 0
}

CHANGED=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD 2>/dev/null)
[ -z "$CHANGED" ] && exit 0

# Solutions afectadas = carpetas de primer nivel con grafo ya construido (graphify-out/)
# y archivos tocados en este commit. Una solution sin grafo todavía no se reconstruye:
# su primer `graphify update .` (adopt o scaffolding) la incorpora sola.
AFFECTED=""
for out in */graphify-out; do
    [ -d "$out" ] || continue
    sol=${out%/graphify-out}
    if printf '%s\n' "$CHANGED" | grep -q "^$sol/"; then
        AFFECTED="$AFFECTED $sol"
    fi
done
[ -z "$AFFECTED" ] && exit 0

LOG="$HOME/.cache/graphify-rebuild.log"
mkdir -p "$(dirname "$LOG")"
echo "[graphify] rebuild en background:$AFFECTED (log: $LOG)"

# Determinismo del clustering (louvain itera sets con orden dependiente del hash seed)
export PYTHONHASHSEED=0
# En Git for Windows/MSYS los hooks heredan pipes frágiles: workers secuenciales por defecto
if [ -n "${WINDIR:-}" ] || [ -n "${MSYSTEM:-}" ]; then
    export GRAPHIFY_MAX_WORKERS="${GRAPHIFY_MAX_WORKERS:-1}"
fi

# Secuencial dentro de un solo subshell en background: el commit retorna ya,
# y no se pisan N rebuilds en paralelo.
(
    for sol in $AFFECTED; do
        echo "== [$(date)] post-commit: graphify update $sol ==" >>"$LOG" 2>&1
        (cd "$sol" && graphify update .) >>"$LOG" 2>&1
    done
) &
